---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import NoCopyright from '../icons/no-copyright.svg';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  // The section to highlight in the navigation, e.g. `/talks`, for pages
  // whose URL does not reveal it.
  section?: string;
  // The link-preview image (Open Graph/Twitter); defaults to the home card.
  image?: PreviewImage;
  // Entries are `article`s with a publication date; other pages `website`s.
  published?: Date;
  // Whether the page has a Markdown twin at its URL plus `.md`.
  markdown?: boolean;
}

export interface PreviewImage {
  src: string;
  width: number;
  height: number;
  alt: string;
}

const {
  title,
  description,
  lang = 'en',
  section,
  image = {
    src: '/og/home.jpg',
    width: 1200,
    height: 630,
    alt: 'Arto Bendiken',
  },
  published,
  markdown,
} = Astro.props;
const path = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(path, Astro.site);
// Tall images (book covers) get the small-thumbnail card on X.
const card = image.height > image.width ? 'summary' : 'summary_large_image';

const sections = [
  { name: 'Talks', href: '/talks' },
  { name: 'Essays', href: '/essays' },
  { name: 'Publications', href: '/publications' },
  { name: 'Projects', href: '/projects' },
  { name: 'Reviews', href: '/reviews' },
  { name: 'Notes', href: '/notes' },
];
const current = (href: string) =>
  href === section || path === href || path.startsWith(`${href}/`);
const LINK =
  'text-neutral-600 hover:text-neutral-900 aria-[current=page]:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 dark:aria-[current=page]:text-neutral-100';
const ICON =
  'text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/index.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Arto Bendiken"
      href="/index.xml"
    />
    {
      markdown && (
        <link
          rel="alternate"
          type="text/markdown"
          href={path === '/' ? '/index.md' : `${path}.md`}
        />
      )
    }
    <meta name="theme-color" content="#171717" />
    <meta property="og:site_name" content="Arto Bendiken" />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:image" content={new URL(image.src, Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {
      published && (
        <meta
          property="article:published_time"
          content={published.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content={card} />
    <meta name="twitter:site" content="@bendiken" />
    <meta name="twitter:creator" content="@bendiken" />
    <script is:inline>
      // Apply a remembered light theme before first paint (dark is the
      // default, set in the markup above).
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute('content', '#ffffff');
        }
      } catch {}
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-white font-sans text-neutral-900 antialiased dark:bg-neutral-900 dark:text-neutral-100"
  >
    <header class="relative border-b border-neutral-200 dark:border-neutral-800">
      <nav class="mx-auto flex max-w-4xl items-center gap-x-6 px-4 py-3">
        <a href="/" class="font-semibold">Arto Bendiken</a>
        <ul class="hidden gap-x-5 md:flex">
          {
            sections.map(({ name, href }) => (
              <li>
                <a
                  href={href}
                  aria-current={current(href) ? 'page' : undefined}
                  class={LINK}
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          id="theme-toggle"
          type="button"
          class={`-m-2 ml-auto p-2 ${ICON}`}
          aria-label="Toggle light and dark mode"
        >
          <svg
            class="size-5 dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 15A9.75 9.75 0 0 1 9 2.25 9.75 9.75 0 1 0 21.75 15Z"
            ></path>
          </svg>
          <svg
            class="hidden size-5 dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              stroke-linecap="round"
              d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
        </button>
        {/* Below `md`, the sections are in a dropdown menu (no JS needed). */}
        <details id="menu" class="group md:hidden">
          <summary
            class={`-m-2 flex cursor-pointer list-none p-2 [&::-webkit-details-marker]:hidden ${ICON}`}
            aria-label="Menu"
          >
            <svg
              class="size-5 group-open:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              class="hidden size-5 group-open:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </summary>
          <ul
            class="absolute inset-x-0 top-full z-10 border-b border-neutral-200 bg-white px-4 py-2 shadow-lg dark:border-neutral-800 dark:bg-neutral-900"
          >
            {
              sections.map(({ name, href }) => (
                <li>
                  <a
                    href={href}
                    aria-current={current(href) ? 'page' : undefined}
                    class={`block py-2 ${LINK}`}
                  >
                    {name}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-12">
      <slot />
    </main>
    <footer
      class="border-t border-neutral-200 px-4 py-6 text-center text-sm text-neutral-500 dark:border-neutral-800 dark:text-neutral-400"
    >
      <p>
        <NoCopyright
          class="mr-1 inline-block size-4 -translate-y-px align-middle"
          aria-hidden="true"
        />
        All <a
          class="underline hover:text-neutral-900 dark:hover:text-neutral-100"
          href="https://github.com/artob/ar.to">materials</a
        > on this website are released into the{' '}
        <a
          class="underline hover:text-neutral-900 dark:hover:text-neutral-100"
          href="https://creativecommons.org/publicdomain/zero/1.0/"
          >public domain</a
        >.
      </p>
    </footer>
    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#171717' : '#ffffff');
        try {
          localStorage.setItem('theme', theme);
        } catch {}
      });

      // Close the dropdown menu on a tap or click outside of it.
      const menu = document.getElementById('menu') as HTMLDetailsElement;
      document.addEventListener('click', (event) => {
        if (menu?.open && !menu.contains(event.target as Node)) {
          menu.open = false;
        }
      });
    </script>
  </body>
</html>
