---
import EntryList from '../components/EntryList.astro';
import EssayGrid from '../components/EssayGrid.astro';
import Base from '../layouts/Base.astro';
import { card } from '../lib/preview';
import { entries } from '../lib/content';

// Featured essays (with an `order`) as cards, then all essays (featured
// ones included) newest first.
const all = await entries('essays');
const featured = all
  .filter((entry) => entry.data.order !== undefined)
  .sort((a, b) => a.data.order! - b.data.order!);
const HEADING =
  'border-b border-neutral-200 pb-2 text-2xl font-bold dark:border-neutral-800';
---

<Base
  title="Arto Bendiken's Essays"
  description="My scribblings on various topics."
  image={card('essays', "Arto's Essays")}
>
  <h1 class="page-title">Arto's Essays</h1>
  <p class="muted mt-3 text-lg">My scribblings on various topics.</p>
  <section class="mt-12">
    <h2 class={HEADING}>Featured Essays</h2>
    <EssayGrid entries={featured} />
  </section>
  <section class="mt-12">
    <h2 class={HEADING}>All Essays</h2>
    <EntryList entries={all} />
  </section>
</Base>
