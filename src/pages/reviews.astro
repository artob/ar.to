---
import EntryList from '../components/EntryList.astro';
import Base from '../layouts/Base.astro';
import { card } from '../lib/preview';
import { entries } from '../lib/content';
---

<Base
  title="Arto Bendiken's Reviews"
  description="My book reviews."
  image={card('reviews', "Arto's Reviews")}
>
  <h1 class="page-title">Arto's Reviews</h1>
  <p class="muted mt-3 text-lg">
    My book reviews, also on <a
      class="link"
      href="https://www.goodreads.com/review/list/22170557-arto-bendiken?shelf=read"
      >Goodreads</a
    >.
  </p>
  <EntryList entries={await entries('reviews')} />
</Base>
