---
import EntryList from '../components/EntryList.astro';
import Base from '../layouts/Base.astro';
import { entries } from '../lib/content';
---

<Base title="Arto Bendiken's Reviews">
  <h1 class="page-title">Reviews</h1>
  <p class="muted mt-3 text-lg">
    My <a
      class="link"
      href="https://www.goodreads.com/review/list/22170557-arto-bendiken?shelf=read"
      >book reviews</a
    >.
  </p>
  <EntryList entries={await entries('reviews')} />
</Base>
