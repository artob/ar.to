---
import EntryList from '../components/EntryList.astro';
import Base from '../layouts/Base.astro';
import { card } from '../lib/preview';
import { entries } from '../lib/content';
---

<Base
  title="Arto Bendiken's Talks"
  description="My recent presentations & interviews."
  image={card('talks', "Arto's Talks")}
  markdown
>
  <h1 class="page-title">Arto's Talks</h1>
  <p class="muted mt-3 text-lg">
    My recent presentations &amp; interviews, also on <a
      class="link"
      href="https://speakerdeck.com/arto">SpeakerDeck</a
    >.
  </p>
  <EntryList entries={await entries('talks')} />
</Base>
