---
import EntryList from '../components/EntryList.astro';
import Base from '../layouts/Base.astro';
import { card } from '../lib/preview';
import { entries } from '../lib/content';
---

<Base
  title="Arto Bendiken's Talks"
  description="My upcoming & recent presentations."
  image={card('talks', "Arto's Talks")}
>
  <h1 class="page-title">Arto's Talks</h1>
  <p class="muted mt-3 text-lg">My upcoming &amp; recent presentations.</p>
  <EntryList entries={await entries('talks')} />
</Base>
