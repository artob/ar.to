---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { plain } from '../lib/inline';
import { card } from '../lib/preview';

// Text sizes by note weight (0-5), as on the legacy index.
const SIZES = [
  'text-sm muted',
  'text-base',
  'text-lg',
  'text-xl font-medium',
  'text-2xl font-semibold',
  'text-3xl font-semibold',
];

// Alphabetical by name, as on the legacy index.
const notes = (await getCollection('notes')).sort((a, b) =>
  a.id.localeCompare(b.id),
);
---

<Base
  title="Arto Bendiken's Notes"
  description="My notes on hundreds of topics, from 3D graphics to ZFS."
  image={card('notes', "Arto's Notes")}
>
  <h1 class="page-title">Arto's Notes</h1>
  <ul class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-2">
    {
      notes.map((note) => (
        <li class={SIZES[note.data.weight]}>
          <a class="hover:underline" href={`/notes/${note.id}`}>
            {plain(note.data.title)}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
