---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { inline, plain } from '../../lib/inline';
import { card } from '../../lib/preview';

export const getStaticPaths = (async () =>
  (await getCollection('notes')).map((note) => ({
    params: { name: note.id },
    props: { note },
  }))) satisfies GetStaticPaths;

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base
  title={`Arto's Notes re: ${plain(note.data.title)}`}
  description={`Arto Bendiken's notes re: ${plain(note.data.title)}.`}
  image={card('notes', "Arto's Notes")}
  section="/notes"
>
  <article class="note">
    <header class="mb-10">
      <p class="muted text-sm"><a class="link" href="/notes">Arto's Notes</a> re:</p>
      <h1
        class="page-title mt-1 [&_a]:link"
        set:html={inline(note.data.title)}
      />
    </header>
    <div class="prose max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</Base>
