---
import ProjectGrid from '../components/ProjectGrid.astro';
import Base from '../layouts/Base.astro';
import { card } from '../lib/preview';
import { entries } from '../lib/content';

// Pinned projects (with an `order`) first, then the rest newest first.
const projects = (await entries('projects')).sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity),
);
---

<Base
  title="Arto Bendiken's Projects"
  description="My open-source projects & initiatives."
  image={card('projects', "Arto's Projects")}
>
  <h1 class="page-title">Arto's Projects</h1>
  <p class="muted mt-3 text-lg">
    My open-source projects &amp; initiatives, also on <a
      class="link"
      href="https://github.com/artob">GitHub</a
    >.
  </p>
  <ProjectGrid entries={projects} />
</Base>
