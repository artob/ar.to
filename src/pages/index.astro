---
import EntryList from '../components/EntryList.astro';
import Hero from '../components/Hero.astro';
import Base from '../layouts/Base.astro';
import { tagline } from '../data/contact';
import { entries } from '../lib/content';

const RECENT = 5;
const recent = [
  { title: 'Recent Talks', href: '/talks', all: 'All talks', section: 'talks' },
  {
    title: 'Recent Essays',
    href: '/essays',
    all: 'All essays',
    section: 'essays',
  },
] as const;
---

<Base title="Arto Bendiken" description={tagline} markdown>
  <Hero />
  {
    recent.map(async ({ title, href, all, section }) => (
      <section class="mt-12">
        <div class="flex items-baseline justify-between border-b border-neutral-200 pb-2 dark:border-neutral-800">
          <h2 class="text-2xl font-bold">{title}</h2>
          <a
            href={href}
            class="text-sm text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            {all} →
          </a>
        </div>
        <EntryList entries={(await entries(section)).slice(0, RECENT)} />
      </section>
    ))
  }
</Base>
